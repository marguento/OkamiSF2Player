--- a/src/rvoice/fluid_rvoice_dsp_sinc.hpp
+++ b/src/rvoice/fluid_rvoice_dsp_sinc.hpp
@@ -124,7 +124,7 @@ static inline fluid_real_t kaiser_signalsmith(fluid_real_t i_shifted)
  *           sinc(n*pi) = 0 for all non-zero integers n).
  */
 template<int SINC_ORDER>
-static inline fluid_real_t fluid_interp_sinc_kernel(const std::array<fluid_real_t, SINC_ORDER> &s, fluid_real_t x)
+static inline fluid_real_t fluid_interp_sinc_kernel_direct(const std::array<fluid_real_t, SINC_ORDER> &s, fluid_real_t x)
 {
     static_assert(SINC_ORDER >= 1 && SINC_ORDER != 2, "SINC_ORDER must be at least 1 and not equal to 2");
 
@@ -180,3 +180,51 @@ static inline fluid_real_t fluid_interp_sinc_kernel(const std::array<fluid_real_
      * modulation artifacts (harmonic distortion) as fractional phase varies. */
     return result / sum;
 }
+
+
+/* SF2 Player: the kernel above computes SINC_ORDER sines and cosines for every output
+ * sample of every voice. Its coefficients depend only on the fractional phase x, so
+ * they are tabulated once per order (1024 phases, each row normalized like the direct
+ * kernel) and interpolated linearly between neighbouring phases. The result stays within
+ * about -120 dB of the direct kernel. */
+template<int SINC_ORDER>
+struct fluid_sinc_table
+{
+    static constexpr int phases = 1024;
+    std::array<std::array<fluid_real_t, SINC_ORDER>, phases + 1> rows;
+
+    fluid_sinc_table()
+    {
+        for(int p = 0; p <= phases; p++)
+        {
+            std::array<fluid_real_t, SINC_ORDER> unit {};
+            for(int i = 0; i < SINC_ORDER; i++)
+            {
+                unit.fill(0);
+                unit[i] = 1;
+                rows[p][i] = fluid_interp_sinc_kernel_direct<SINC_ORDER>(unit, (fluid_real_t)p / phases);
+            }
+        }
+    }
+};
+
+template<int SINC_ORDER>
+static inline fluid_real_t fluid_interp_sinc_kernel(const std::array<fluid_real_t, SINC_ORDER> &s, fluid_real_t x)
+{
+    static const fluid_sinc_table<SINC_ORDER> table;
+    constexpr int phases = fluid_sinc_table<SINC_ORDER>::phases;
+
+    fluid_real_t position = x * phases;
+    int row = (int)position;
+    row = row < 0 ? 0 : (row >= phases ? phases - 1 : row);
+    const fluid_real_t frac = position - (fluid_real_t)row;
+    const auto &a = table.rows[row];
+    const auto &b = table.rows[row + 1];
+
+    fluid_real_t result = 0;
+    for(int i = 0; i < SINC_ORDER; i++)
+    {
+        result += (a[i] + frac * (b[i] - a[i])) * s[i];
+    }
+    return result;
+}
